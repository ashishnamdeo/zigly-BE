# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Public base URL this server is reachable at (used to build a public link to
# the uploaded file so Twilio can fetch it). Must be HTTPS in production.
# e.g. https://api.yourdomain.com
APP_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (your Shopify
# storefront domain(s)). Example: https://your-store.myshopify.com,https://yourdomain.com
ALLOWED_ORIGINS=https://your-store.myshopify.com

# ---------------------------------------------------------------------------
# Twilio WhatsApp API
# ---------------------------------------------------------------------------
# From Twilio Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Your Twilio WhatsApp sender number, E.164 format (e.g. sandbox number +14155238886)
TWILIO_WHATSAPP_FROM=+14155238886
# The WhatsApp number that should RECEIVE the prescription (pharmacist/store), E.164 format
TWILIO_WHATSAPP_TO=+91XXXXXXXXXX
# Approved Content Template SID (starts with "HX") used for the name/phone notification.
# Create it in Twilio Console > Messaging > Content Template Builder with two
# variables, e.g. "New prescription from {{1}}, phone {{2}}."
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
