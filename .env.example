# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Public base URL this server is reachable at (used to build a public link to
# the uploaded file so Gupshup can fetch it). Must be HTTPS in production.
# e.g. https://api.yourdomain.com
APP_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (your Shopify
# storefront domain(s)). Example: https://your-store.myshopify.com,https://yourdomain.com
ALLOWED_ORIGINS=https://your-store.myshopify.com

# ---------------------------------------------------------------------------
# Gupshup WhatsApp API
# ---------------------------------------------------------------------------
# Your Gupshup Enterprise account userid/password (Console > Account Info)
GUPSHUP_USERID=2000XXXXXX
GUPSHUP_PASSWORD=your_gupshup_password
# The WhatsApp number that should RECEIVE the prescription (pharmacist/store), E.164 format
GUPSHUP_SEND_TO=+91XXXXXXXXXX
# Approved HSM template text with {{1}}/{{2}} placeholders for name/phone, e.g.
# "New prescription received from {{1}}, phone {{2}}."
GUPSHUP_TEMPLATE_TEXT=New prescription received from {{1}}, phone {{2}}.

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
