# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API (your Shopify
# storefront domain(s)). Example: https://your-store.myshopify.com,https://yourdomain.com
ALLOWED_ORIGINS=https://your-store.myshopify.com

# ---------------------------------------------------------------------------
# Gupshup WhatsApp API
# ---------------------------------------------------------------------------
# Gupshup Conversation Cloud API key (Console > Integrations > Custom Integration)
GUPSHUP_API_KEY=your_gupshup_api_key
# The WhatsApp Business number this app sends FROM, E.164 format
GUPSHUP_SOURCE=+91XXXXXXXXXX
# The WhatsApp number that should RECEIVE the prescription (pharmacist/store), E.164 format
GUPSHUP_SEND_TO=+91XXXXXXXXXX
# Secondary/tertiary doctor numbers, notified at the same time as GUPSHUP_SEND_TO. Whichever
# doctor responds first, the others get a status notification instead of acting on a stale
# request. Both optional — set neither, either, or both.
GUPSHUP_SEND_TO_SECONDARY=+91XXXXXXXXXX
GUPSHUP_SEND_TO_TERTIARY=+91XXXXXXXXXX
# Approved HSM template ID (Console > Templates)
GUPSHUP_TEMPLATE_ID=your-template-uuid
# Approved HSM template ID for customer approve/reject status updates
GUPSHUP_STATUS_TEMPLATE_ID=your-status-template-uuid
# Approved HSM template ID for notifying the OTHER doctors a request was already handled
# (takes customer name, responding doctor's name, Approved/Rejected). Optional — until set,
# falls back to reusing GUPSHUP_STATUS_TEMPLATE_ID with the product list instead.
GUPSHUP_DOCTOR_STATUS_TEMPLATE_ID=your-doctor-status-template-uuid
# Display names for GUPSHUP_SEND_TO / _SECONDARY / _TERTIARY, used to fill the doctor-status
# template's "responding doctor's name" variable.
GUPSHUP_PRIMARY_DOCTOR_NAME=Dr. Name
GUPSHUP_SECONDARY_DOCTOR_NAME=Dr. Name
GUPSHUP_TERTIARY_DOCTOR_NAME=Dr. Name
# App name registered on Gupshup (required by the API as "src.name")
GUPSHUP_APP_NAME=your_gupshup_app_name

# ---------------------------------------------------------------------------
# Shopify Admin API (writes the rx-prescription-order metafield back onto
# each order after the orders/create webhook fires)
# ---------------------------------------------------------------------------
# your-store.myshopify.com
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Custom app Admin API access token with write_orders scope (Admin > Settings
# > Apps and sales channels > Develop apps)
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-01
# Must match a "custom data" order metafield definition (Admin > Settings >
# Custom data > Orders) if you want it visible/editable in the order admin UI.
# Defaults below match Shopify's no-code "custom" namespace.
SHOPIFY_RX_METAFIELD_NAMESPACE=custom
SHOPIFY_RX_METAFIELD_KEY=rx-prescription-order

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10

# ---------------------------------------------------------------------------
# S3 (file storage — uploaded prescriptions are stored here so Gupshup has a
# stable public URL to fetch from). No access keys needed when running on
# Lambda — the execution role's permissions are used automatically.
# ---------------------------------------------------------------------------
S3_BUCKET_NAME=zigly-prescriptions-uploads
S3_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Database (tracks prescription requests + Approve/Reject status from the
# Gupshup webhook)
# ---------------------------------------------------------------------------
DB_HOST=your-db-instance.xxxxx.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_db_username
DB_PASSWORD=your_db_password
