{% comment %}
  Upload Prescription section.
  Add this file to your theme's `sections/` folder, then add the section to
  any page from the theme editor (Online Store > Themes > Customize > Add
  section). Configure the backend URL in the section settings below.
{% endcomment %}

<div class="prescription-upload" id="prescription-upload-{{ section.id }}">
  <div class="prescription-upload__wrapper">
    <h2 class="prescription-upload__title">{{ section.settings.heading | default: 'Upload Your Prescription' }}</h2>
    <p class="prescription-upload__subtitle">
      {{ section.settings.subheading | default: 'Upload a photo or PDF of your prescription and our pharmacist will confirm your order over WhatsApp.' }}
    </p>

    <form
      class="prescription-upload__form"
      data-prescription-form
      data-endpoint="{{ section.settings.backend_url | default: 'https://your-backend-domain.com/api/prescription/upload' }}"
      novalidate
    >
      <div class="prescription-upload__field">
        <label for="prescription-name-{{ section.id }}">Full name</label>
        <input
          type="text"
          id="prescription-name-{{ section.id }}"
          name="name"
          required
          autocomplete="name"
        >
      </div>

      <div class="prescription-upload__field">
        <label for="prescription-phone-{{ section.id }}">WhatsApp phone number</label>
        <input
          type="tel"
          id="prescription-phone-{{ section.id }}"
          name="phone"
          placeholder="e.g. 91XXXXXXXXXX"
          required
          autocomplete="tel"
        >
      </div>

      <div class="prescription-upload__field">
        <label for="prescription-file-{{ section.id }}">Prescription (JPG, PNG, or PDF)</label>
        <input
          type="file"
          id="prescription-file-{{ section.id }}"
          name="prescription"
          accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf"
          required
        >
      </div>

      <button type="submit" class="prescription-upload__submit">
        <span class="prescription-upload__submit-text">Submit prescription</span>
      </button>

      <p class="prescription-upload__status" data-prescription-status role="status" aria-live="polite"></p>
    </form>
  </div>
</div>

{{ 'upload-prescription.css' | asset_url | stylesheet_tag }}
<script src="{{ 'upload-prescription.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Upload Prescription",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upload Your Prescription"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "url",
      "id": "backend_url",
      "label": "Backend upload endpoint URL",
      "info": "Full URL of the Node.js backend's /api/prescription/upload endpoint."
    }
  ],
  "presets": [
    {
      "name": "Upload Prescription"
    }
  ]
}
{% endschema %}
